# NudgeMyInvoice - sandbox/local example only. Never commit real values.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
# Local SQLite planned; use postgres://... when running Postgres
DATABASE_URL=file:./data/nudgemyinvoice.sqlite
DATABASE_DIALECT=sqlite

# PayPal REST **SANDBOX** ONLY
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Anthropic server-side credentials
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=1024

# Local development session signing; generate a strong random value locally
SESSION_SECRET=

# Webhook testing tunnel/public origin; never point to live endpoints
PUBLIC_WEBHOOK_URL=
# Do not enable simulator bypasses in deployed environments.
WEBHOOK_TEST_MODE=off
