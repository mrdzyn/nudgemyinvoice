# NudgeMyInvoice - sandbox/local example only. Never commit real values.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
# The API (authentication and approvals) requires PostgreSQL and rejects any other URL.
# The owner decision on SQLite parity is still pending and is NOT resolved by this file.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/nudgemyinvoice

# PayPal REST **SANDBOX** ONLY
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Real sandbox draft-invoice creation is OFF unless explicitly enabled. When true, BOTH credentials
# below are mandatory (the API refuses to start otherwise). Sandbox credentials only; never live.
PAYPAL_DRAFTS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# OpenAI server-side credentials (never exposed to the browser bundle or logs)
OPENAI_API_KEY=
# Required, no default. Pick a currently supported low-cost model from
# https://developers.openai.com/api/docs/models and verify availability/pricing yourself.
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1024

# Required, at least 32 characters. Generate locally, e.g.: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
# Listen interface. Default 127.0.0.1. 0.0.0.0 (hosted container) is accepted ONLY with NODE_ENV=production.
# HOST=127.0.0.1
# false (default), true (every hop; development behind a known local proxy only) or a hop count 1-3
# (the number of trusted proxies in front of the server; the ONLY accepted non-false value in production).
TRUST_PROXY=false
# Directory with the built web app, served from the API's own origin (hosted mode). Defaults to
# apps/web/dist when NODE_ENV=production; unset in development (Vite serves the page).
# WEB_DIST_DIR=

# One-time operator provisioning (read ONLY by `pnpm --filter @nmi/api provision-operator`;
# set in your shell for that command, do not store a real password in any file).
# NMI_OPERATOR_USERNAME=
# NMI_OPERATOR_PASSWORD=

# Webhook testing tunnel/public origin; never point to live endpoints
PUBLIC_WEBHOOK_URL=
# Do not enable simulator bypasses in deployed environments.
WEBHOOK_TEST_MODE=off
